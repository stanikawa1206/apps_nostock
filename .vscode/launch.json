{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "scrape_worker",
            "type": "debugpy",
            "request": "launch",
            "module": "apps.inventory.scrape_worker",
            "cwd": "${workspaceFolder}"
        }
    ]
}